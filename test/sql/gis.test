# GIS domain acceptance tests for hydrology.
require vgi

require-env HYDROLOGY_WORKER

statement ok
ATTACH 'hydrology' (TYPE vgi, LOCATION '{HYDROLOGY_WORKER}');

# Upstream catchments on bundled synthetic data
query TTT
SELECT station_id, cell_count, area_m2 FROM hydrology.main.catchments((SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y))) ORDER BY station_id;
----
outlet	49	4900.0

# Catchment land cover on bundled synthetic data
query TT
SELECT sum(area_m2), min(coverage_fraction) FROM hydrology.main.landcover((SELECT station_id, geometry_wkb FROM hydrology.main.catchments((SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y))) WHERE status='ok'));
----
4900.0	1.0

# Composed: dominant upstream land cover for nested and side gauges (catchments -> landcover)
query TTTT
WITH basins AS (SELECT station_id, area_m2, geometry_wkb FROM hydrology.main.catchments((SELECT * FROM (VALUES ('west', 500015.0, 4100035.0), ('mid', 500035.0, 4100035.0), ('east', 500055.0, 4100035.0), ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y))) WHERE status = 'ok') SELECT b.station_id, b.area_m2, arg_max(l.class_code, l.area_m2) AS dominant_class, max(l.fraction_of_valid) AS dominant_share FROM basins AS b JOIN hydrology.main.landcover((SELECT station_id, geometry_wkb FROM basins)) AS l ON l.station_id = b.station_id GROUP BY b.station_id, b.area_m2 ORDER BY b.station_id;
----
east	200.0	20	1.0
mid	1600.0	20	0.625
outlet	4900.0	20	0.5714285714285714
west	200.0	10	1.0

# Composed: intervening land cover between a nested gauge and the valley outlet
query TTTT
WITH gauges AS (SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0), ('mid', 500035.0, 4100035.0)) AS g(station_id, x, y)), cover AS (SELECT station_id, class_code, area_m2 FROM hydrology.main.landcover((SELECT station_id, geometry_wkb FROM hydrology.main.catchments((SELECT * FROM gauges)) WHERE status = 'ok'))) SELECT class_code, sum(area_m2) FILTER (WHERE station_id = 'outlet') AS outlet_area_m2, sum(area_m2) FILTER (WHERE station_id = 'mid') AS upstream_gauge_area_m2, outlet_area_m2 - upstream_gauge_area_m2 AS intervening_area_m2 FROM cover GROUP BY class_code ORDER BY class_code;
----
10	2100.0	600.0	1500.0
20	2800.0	1000.0	1800.0

# Empty station relation
query T
SELECT count(*) FROM hydrology.main.catchments((SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y) WHERE false));
----
0

# Multiple input batches preserve unknown coverage
query TTT
SELECT count(*), count(geometry_wkb), min(status) FROM hydrology.main.catchments((SELECT i::VARCHAR station_id, 0.0 x, 0.0 y FROM range(2501) t(i)));
----
2501	0	outside_dem

statement ok
INSTALL spatial;

statement ok
LOAD spatial;

# Join upstream facilities to catchments
query TTTT
WITH basins AS (SELECT * FROM hydrology.main.catchments((SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y)))),
facilities(facility_id, x, y) AS (VALUES ('upstream-plant', 500015.0, 4100055.0), ('outside-plant', 500095.0, 4100055.0))
SELECT b.station_id, f.facility_id, b.area_m2, b.boundary_limited
FROM basins b JOIN facilities f ON ST_Covers(ST_GeomFromWKB(b.geometry_wkb), ST_Point(f.x, f.y))
ORDER BY b.station_id, f.facility_id;
----
outlet	upstream-plant	4900.0	true

statement error
SELECT * FROM hydrology.main.catchments((SELECT 1 AS wrong_column));
----
Missing input columns

# Constant controls must not accept infinity.
statement error
SELECT * FROM hydrology.main.catchments((SELECT * FROM (VALUES ('outlet', 500035.0, 4100005.0)) AS gauges(station_id, x, y)), snap_radius_m := 'Infinity'::DOUBLE);
----
finite
